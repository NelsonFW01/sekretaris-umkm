# Salin file ini jadi acuan waktu mengisi Vercel → Project Settings →
# Environment Variables. JANGAN buat file .env ini beneran lalu di-commit —
# ini cuma dokumentasi nama variabelnya saja.

# Dipakai oleh api/ai-proxy.js (fallback AI saat user belum isi key sendiri)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Dipakai oleh api/send-otp.js (kirim kode OTP via email)
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Dipakai oleh api/notify.js (push notification via Firebase Cloud Messaging)
# Isi dengan seluruh isi file JSON service account Firebase (dalam satu baris)
FIREBASE_SERVICE_ACCOUNT=

# Dipakai oleh api/cron-invoice-reminder.js (pengingat tagihan otomatis harian)
# Bebas string acak apa saja, minimal 16 karakter. Setelah diisi di Vercel,
# Vercel OTOMATIS mengirim nilai ini sebagai Authorization header tiap cron
# jalan — kamu tidak perlu setting apapun selain menaruh nilainya di sini.
CRON_SECRET=
